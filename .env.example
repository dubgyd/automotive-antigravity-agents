# Automotive Antigravity Workspace - Environment Configuration
# Copy this file to .env and fill in your values if you plan to launch local bash simulation tools

# =============================================================================
# Cloud Platform Credentials (Optional - for cloud / OTA push features)
# =============================================================================

# AWS IoT (For Vehicle Telemetry Testing)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_IOT_ENDPOINT=

# Azure IoT
AZURE_IOT_HUB_CONNECTION_STRING=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =============================================================================
# Commercial Automotive Tool Licenses (Optional - if compiling actual code)
# =============================================================================

# Vector Tools (CANoe, DaVinci Configurator)
VECTOR_LICENSE_SERVER=
VECTOR_LICENSE_FILE=

# ETAS Tools (INCA)
ETAS_LICENSE_SERVER=
ETAS_INCA_LICENSE=

# dSPACE Tools (ControlDesk)
DSPACE_LICENSE_SERVER=

# Note: LLM API Keys (Anthropic) and Claude configuration variables have been 
# officially deprecated. Your local Antigravity platform natively orchestrates 
# AI models and does not require manual token configuration.
